# Раздел «Типовые программы» — правила Apache для виртуального хостинга.
#
# Файл лежит в корне раздела и приезжает с каждой сборкой. Править его на
# сервере не нужно: следующая выкладка перезапишет правку.
#
# mod_rewrite здесь намеренно не используется: «RewriteEngine On» в
# подкаталоге отключает для всех адресов раздела правила mod_rewrite
# корневого .htaccess сайта — переадресацию на HTTPS и с www.
#
# Адрес без завершающего слэша (/tipovye-programmy/pozharnaya-bezopasnost)
# Apache переадресует 301 на адрес со слэшем сам: это DirectorySlash,
# он включён по умолчанию.

# 404 внутри раздела остаётся в разделе.
ErrorDocument 404 /tipovye-programmy/404.html

# Стили и скрипт (catalog.css, catalog.js) хостинг отдаёт через nginx
# напрямую, мимо этого файла: срок кэша у них свой — 45 дней, и пароль на них
# не действует. Поэтому их адреса на страницах несут версию ?v= по
# содержимому: после выкладки браузер сразу берёт новые файлы. Поведение
# проверено на хостинге 14.09.2026.
<IfModule mod_expires.c>
  ExpiresActive On
  # Индекс поиска обновляется вместе с данными.
  ExpiresByType application/json "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # HTML не кэшируем: содержание нормативное и меняется по мере сверки.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ВРЕМЕННО: раздел закрыт паролем до проверки (сборка с --protect).
# Снимается пересборкой без --protect и обычной выкладкой, не правкой
# этого файла на сервере. Файл паролей лежит на хостинге вне каталога сайта.
# Пароль закрывает страницы, индекс поиска и sitemap.xml. catalog.css и
# catalog.js хостинг отдаёт без пароля (см. выше) — содержания каталога в них нет.
AuthType Basic
AuthName "ARMA: tipovye-programmy"
AuthUserFile /var/www/u3083275/data/.htpasswd-arma-lab

# Пароль спрашивается только на https://arma-lab.ru. Проверка пароля в Apache идёт
# раньше переадресации на HTTPS из корневого .htaccess: без этого условия
# запрос по http:// или через www получил бы 401, и браузер отправил бы
# пароль открытым текстом. Такой запрос получает 403, а 403 переадресует на
# тот же адрес по HTTPS. Поведение проверено на хостинге 14.09.2026.
<RequireAll>
  Require expr "%{HTTP:X-Forwarded-Proto} == 'https' && %{HTTP_HOST} == 'arma-lab.ru'"
  Require valid-user
</RequireAll>
ErrorDocument 403 https://arma-lab.ru%{REQUEST_URI}

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
