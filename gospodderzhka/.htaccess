# Навигатор господдержки: служебные заголовки раздела.
# Индексация закрыта и мета-тегом в index.html, и заголовком ниже.
# Ограничение встраивания (CSP frame-ancestors) не ставится: домены, с которых
# мобильное приложение GetCourse показывает уроки, официально не подтверждены.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Из PHP-файлов раздела снаружи доступен только lead.php
<FilesMatch "\.php$">
  Require all denied
</FilesMatch>
<Files "lead.php">
  Require all granted
</Files>
